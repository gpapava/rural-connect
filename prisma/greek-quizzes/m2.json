        {
            "id": "ps-mc-4",
            "type": "multiple_choice",
            "text": "\u0388\u03c7\u03b5\u03b9\u03c2 \u03ba\u03bf\u03bb\u03bb\u03ae\u03c3\u03b5\u03b9 \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03c0\u03c1\u03cc\u03b2\u03bb\u03b7\u03bc\u03b1 \u03b5\u03b4\u03ce \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03cd \u03ba\u03b1\u03b9\u03c1\u03cc. \u0391\u03c0\u03bf\u03c6\u03b1\u03c3\u03af\u03b6\u03b5\u03b9\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03b5\u03b9\u03c2 \u03bc\u03b9\u03b1 \u03bc\u03b9\u03ba\u03c1\u03ae \u03b2\u03cc\u03bb\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03c3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03bd\u03b1 \u03c4\u03bf \u03c3\u03ba\u03ad\u03c6\u03c4\u03b5\u03c3\u03b1\u03b9. \u039b\u03af\u03b3\u03b1 \u03bb\u03b5\u03c0\u03c4\u03ac \u03b1\u03c1\u03b3\u03cc\u03c4\u03b5\u03c1\u03b1, \u03c3\u03bf\u03c5 \u03ad\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03bc\u03c5\u03b1\u03bb\u03cc \u03bc\u03b9\u03b1 \u03bb\u03cd\u03c3\u03b7. \u03a0\u03bf\u03b9\u03bf \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b5\u03b3\u03ba\u03b5\u03c6\u03ac\u03bb\u03bf\u03c5 \u03b5\u03c5\u03b8\u03cd\u03bd\u03b5\u03c4\u03b1\u03b9 \u03ba\u03c5\u03c1\u03af\u03c9\u03c2 \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc;",
