        {
            "id": "ps-mc-1",
            "type": "multiple_choice",
            "text": "\u03a5\u03c0\u03bf\u03b2\u03ac\u03bb\u03bb\u03b5\u03b9\u03c2 \u03b1\u03af\u03c4\u03b7\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03bc\u03b9\u03b1 \u03b8\u03ad\u03c3\u03b7 \u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2, \u03b1\u03bb\u03bb\u03ac \u03c8\u03ac\u03c7\u03bd\u03b5\u03b9\u03c2 \u03bc\u03cc\u03bd\u03bf \u03ba\u03c1\u03b9\u03c4\u03b9\u03ba\u03ad\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03bf\u03c5\u03bd \u03cc\u03c4\u03b9 \u03b7 \u03b5\u03c4\u03b1\u03b9\u03c1\u03b5\u03af\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03be\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae, \u03b1\u03b3\u03bd\u03bf\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b9\u03c2 \u03b1\u03c1\u03bd\u03b7\u03c4\u03b9\u03ba\u03ad\u03c2. \u03a0\u03bf\u03b9\u03b1 \u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ae \u03c0\u03c1\u03bf\u03ba\u03b1\u03c4\u03ac\u03bb\u03b7\u03c8\u03b7 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03c5\u03c4\u03ae;",
