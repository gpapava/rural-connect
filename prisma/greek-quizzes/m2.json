        {
            "id": "ps-mc-3",
            "type": "multiple_choice",
            "text": "\u0395\u03b4\u03ce \u03ba\u03b1\u03b9 \u03b5\u03b2\u03b4\u03bf\u03bc\u03ac\u03b4\u03b5\u03c2 \u03ad\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03af\u03b4\u03b9\u03b1 \u03b4\u03b9\u03b1\u03c6\u03c9\u03bd\u03af\u03b1 \u03bc\u03b5 \u03ad\u03bd\u03b1\u03bd \u03c3\u03c5\u03b3\u03ba\u03ac\u03c4\u03bf\u03b9\u03ba\u03bf. \u03a3\u03c5\u03bd\u03b5\u03b9\u03b4\u03b7\u03c4\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c2 \u03cc\u03c4\u03b9 \u03bf \u03b1\u03c1\u03c7\u03b9\u03ba\u03cc\u03c2 \u03c3\u03bf\u03c5 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c4\u03bf\u03c5 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 (\u00ab\u03b1\u03c0\u03bb\u03ac \u03b4\u03b5\u03bd \u03c4\u03b1 \u03c0\u03ac\u03bc\u03b5 \u03ba\u03b1\u03bb\u03ac\u00bb) \u03af\u03c3\u03c9\u03c2 \u03bd\u03b1 \u03bc\u03b7\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ae\u03c2. \u03a0\u03bf\u03b9\u03b1 \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03b5\u03c0\u03af\u03bb\u03c5\u03c3\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03b8\u03b1 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03b9\u03c2;",
